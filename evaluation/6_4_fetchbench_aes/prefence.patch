@@ -0,0 +1,26 @@
+#!/bin/bash
+set -xe
+
+cd covert-channel/kernel-modules
+
+echo "Loading cache module"
+cd rpi4-module-cache
+make clean
+make
+sudo bash module_load.sh
+cd ..
+
+echo "Loading CCR module"
+cd rpi4-module-ccr/armv8
+make clean
+make
+sudo bash module_load.sh
+cd ..
+
+cd
+
+echo "Fixing CPU frequency"
+sudo cpufreq-set -c 0 -f 1.8GHz
+sudo cpufreq-set -c 1 -f 1.8GHz
+sudo cpufreq-set -c 2 -f 1.8GHz
+sudo cpufreq-set -c 3 -f 1.8GHz
