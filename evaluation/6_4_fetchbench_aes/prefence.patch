diff --git a/aes-attack/program/runscript_prefence.py b/aes-attack/program/runscript_prefence.py
new file mode 100644
index 0000000..ab0d210
--- /dev/null
+++ b/aes-attack/program/runscript_prefence.py
@@ -0,0 +1,45 @@
+import os
+import subprocess
+import datetime
+import glob
+import secrets
+import sys
+
+if len(sys.argv) < 2 or sys.argv[1] not in ['with_prefetch', 'without_prefetch']:
+    print("Please specify either 'with_prefetch' or 'without_prefetch' as first command line parameter.")
+    sys.exit(1)
+
+TAG = sys.argv[1]
+NO_ITERATIONS = 100
+START_OFFSET = 0
+
+with open("src/prefence_state.hh", "w") as file:
+    file.write("#pragma once\n")
+    if TAG == "with_prefetch":
+        file.write("#define ENABLE_PREFENCE (false)")
+    elif TAG == "without_prefetch":
+        file.write("#define ENABLE_PREFENCE (true)")
+
+def update_key():
+    new_key = secrets.token_bytes(16)
+    keystr = ""
+    for i in range(len(new_key)):
+        keystr += f"0x{new_key[i]:02x}, "
+    with open("src/key.hh", "w") as keyfile:
+        keyfile.write(keystr)
+
+
+for iteration in range(START_OFFSET, START_OFFSET + NO_ITERATIONS):
+    update_key()
+    print(f"{datetime.datetime.now()} iteration: {iteration}")
+
+    subprocess.run(["make", "-C", "build"])
+    subprocess.run(["bash", "runscript_internal.sh"])
+    subprocess.run(["gzip", "out.log"])
+    os.rename("out.log.gz", f"out-{TAG}-{iteration:03d}.log.gz")
+    for mapfile in glob.glob("maps-*.txt"):
+        os.rename(mapfile, f"out-{mapfile}.{TAG}-{iteration:03d}.txt")
+
+notify_path = os.path.expanduser("~/notify.sh")
+if os.path.isfile(notify_path):
+    subprocess.run(["bash", notify_path, "Experiment done."])
