@@ -0,0 +1,47 @@
+import re
+import statistics
+
+import matplotlib.pyplot as plt
+
+INPUT = {
+    "with_prefetch": "out-with_prefetch.log",
+    "without_prefetch": "out-without_prefetch.log",
+}
+COLORS = {
+    "with_prefetch": "blue",
+    "without_prefetch": "red",
+}
+datasets = {}
+
+for label, filepath in INPUT.items():
+    datasets[label] = []
+    with open(filepath) as file:
+        for line in file:
+            rx = re.match(r"^Time: (?P<time>\d+)\n$", line)
+            if rx is not None:
+                datasets[label].append(int(rx.group("time")))
+            else:
+                assert False, "regex failed"
+
+for label, dataset in datasets.items():
+    print(f"median({label}) = {statistics.median(dataset)}")
+
+hist_min = 800
+hist_max = 1000
+
+for label, dataset in datasets.items():
+    plt.hist(
+        x=dataset,
+        label=label,
+        color=COLORS[label],
+        alpha=0.5,
+        range=(hist_min, hist_max),
+        bins=hist_max-hist_min,
+    )
+
+plt.legend()
+plt.xlabel("time (cycles)")
+plt.ylabel("frequency")
+plt.savefig("plot_timing.png")
+
+
