@@ -0,0 +1,69 @@
+#include <stdio.h>
+#include <stdlib.h>
+#include <inttypes.h>
+
+#include <mbedtls/aes.h>
+
+#include "common_test.hh"
+#include "prefence.hh"
+
+#define NO_REPETITIONS 1e7
+
+int main(int argc, char** argv) {
+	// pin process to victim core
+	move_process_to_cpu(0, 0);
+	timing_init();
+	srand(0);
+
+	// Get desired PreFence state from command line
+	uint8_t enable_prefence = 0;
+	if (argc >= 2 && (argv[1][0] == '0' || argv[1][0] == '1')) {
+		enable_prefence = (argv[1][0] == '1') ? 1 : 0;
+	} else {
+		puts("Please specify either 0 (no prefence) or 1 (prefence) as first command line parameter.");
+		return -1;
+	}
+
+	// AES setup
+	uint8_t key[] = { 
+		0x27, 0xb7, 0xa0, 0xc4, 0x99, 0x1b, 0xf4, 0x9c,
+		0x1d, 0x48, 0x49, 0x35, 0x8e, 0xb5, 0x52, 0x1b,
+	};
+	uint8_t output[16];
+	mbedtls_aes_context ctx;
+	mbedtls_aes_init(&ctx);
+	mbedtls_aes_setkey_enc(&ctx, key, 128);
+
+	for (size_t repetition = 0; repetition < NO_REPETITIONS; repetition++) {
+		// Generate new random plaintext block
+		uint8_t plaintext[16];
+		for (size_t i = 0; i < sizeof(plaintext) / sizeof(int); i++) {
+			int r = rand();
+			((int*)plaintext)[i] = r;
+		}
+
+		// Set PreFence bit, if desired.
+		int pfdis_before = get_pfdis_flag();
+		set_pfdis_flag(enable_prefence);
+
+		// Take timestamp before library call
+		mfence();
+		uint64_t time_before = rdtsc();
+		mfence();
+
+		// library call: encrypt plaintext block with key
+		mbedtls_internal_aes_encrypt(&ctx, plaintext, output);
+		
+		// Take timestamp after library call
+		mfence();
+		uint64_t time_after = rdtsc();
+		mfence();
+
+		// Reset prefetcher state
+ 		set_pfdis_flag(pfdis_before);
+
+ 		printf("Time: %lu\n", time_after - time_before);
+	}
+	
+	return 0;
+}
diff --git a/aes-attack/measure_timing/src/prefence.hh b/aes-attack/measure_timing/src/prefence.hh
new file mode 100644
index 0000000..7b737b7
--- /dev/null
+++ b/aes-attack/measure_timing/src/prefence.hh
@@ -0,0 +1,22 @@
+#pragma once
+
+#include <stdlib.h> // EXIT_FAILURE
+
+#include <sys/prctl.h>
+#define PR_SET_PREFETCH_DISABLE     128
+#define PR_GET_PREFETCH_DISABLE     129
+
+static inline void set_pfdis_flag(int new_value) {
+    int ret = prctl(PR_SET_PREFETCH_DISABLE, new_value, NULL, NULL);
+    if (ret != 0) {
+        exit(EXIT_FAILURE);
+    }
+}
+
+static inline int get_pfdis_flag(void) {
+    int flag = prctl(PR_GET_PREFETCH_DISABLE, NULL, NULL, NULL);
+    if (flag != 0 && flag != 1) {
+        exit(EXIT_FAILURE);
+    }
+    return flag;
+}
